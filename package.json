{
  "name": "agentfoundry",
  "version": "1.0.0",
  "description": "面向投资人的端到端智能体编排设计师",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run build:clean && npm run build:compile",
    "build:clean": "rm -rf dist",
    "build:compile": "babel src -d dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:golden": "node scripts/run-golden-tests.js",
    "test:redteam": "node scripts/run-redteam-tests.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "validate": "npm run lint && npm run test",
    "docker:build": "docker build -t agentfoundry:latest .",
    "docker:run": "docker run -p 3000:3000 agentfoundry:latest",
    "deploy:staging": "npm run build && npm run deploy:k8s:staging",
    "deploy:production": "npm run build && npm run deploy:k8s:production",
    "deploy:k8s:staging": "kubectl apply -f k8s/staging/",
    "deploy:k8s:production": "kubectl apply -f k8s/production/",
    "monitor:start": "node scripts/monitoring.js",
    "telemetry:validate": "node scripts/validate-telemetry.js",
    "policies:validate": "node scripts/validate-policies.js",
    "gates:check": "node scripts/check-gates.js",
    "setup": "npm install && npm run policies:validate && npm run telemetry:validate",
    "clean": "rm -rf node_modules dist coverage .nyc_output",
    "reset": "npm run clean && npm install"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "mvp",
    "investment",
    "stage-gate",
    "compliance",
    "automation"
  ],
  "author": "AgentFoundry Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/agentfoundry.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/agentfoundry/issues"
  },
  "homepage": "https://github.com/your-org/agentfoundry#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2",
    "winston": "^3.10.0",
    "axios": "^1.4.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "uuid": "^9.0.0",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "mongoose": "^7.4.0",
    "redis": "^4.6.7",
    "bull": "^4.11.3",
    "prometheus-client": "^14.2.0",
    "opentelemetry-api": "^1.4.1",
    "yaml": "^2.3.1",
    "markdown-it": "^13.0.1",
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.9",
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "eslint": "^8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "prettier": "^3.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run validate"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write",
      "git add"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx}"
    ]
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "16"
          }
        }
      ]
    ]
  }
}