  "evaluation_criteria": {
    "scalability": {
      "description": "系统扩展能力",
      "weight": 0.25,
      "metrics": [
        "水平扩展支持",
        "性能瓶颈识别",
        "负载均衡策略"
      ]
    },
    "maintainability": {
      "description": "系统可维护性",
      "weight": 0.25,
      "metrics": [
        "模块化程度",
        "技术栈合理性",
        "部署复杂度"
      ]
    },
    "security": {
      "description": "安全性设计",
      "weight": 0.25,
      "metrics": [
        "认证授权机制",
        "数据保护措施",
        "安全监控"
      ]
    },
    "performance": {
      "description": "性能表现",
      "weight": 0.25,
      "metrics": [
        "响应时间",
        "吞吐量",
        "资源利用率"
      ]
    }
  },
  "adr_requirements": {
    "minimum_count": 2,
    "required_sections": [
      "Status",
      "Context",
      "Decision",
      "Consequences"
    ],
    "quality_criteria": [
      "决策背景清晰",
      "备选方案对比",
      "影响分析充分"
    ]
  },
  "usage_instructions": {
    "purpose": "评测AI生成架构设计的质量",
    "scoring": "每个测试用例按四个维度评分，权重相等",
    "threshold": "总分≥0.8视为通过，<0.75需要重新设计",
    "frequency": "每次架构设计功能更新后运行"
  }
}