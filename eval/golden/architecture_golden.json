          "用户服务",
          "商品服务",
          "订单服务",
          "支付服务",
          "库存服务"
        ],
        "data_architecture": {
          "primary_db": "PostgreSQL集群",
          "cache": "Redis集群",
          "search": "Elasticsearch",
          "message_queue": "Apache Kafka"
