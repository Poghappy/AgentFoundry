        ],
        "out_of_scope": [
          "财务管理功能",
          "人力资源管理",
          "客户关系管理"
        ]
      },
      "quality_metrics": {
        "clarity": 0.9,
        "completeness": 0.9,
        "testability": 0.85,
        "feasibility": 0.85
      }
    },
    {
      "id": "PRD004",
      "input": {
        "product_type": "金融理财应用",
        "target_users": ["个人投资者", "理财顾问", "机构客户"],
        "business_goals": [
          "增加用户投资收益",
          "降低投资风险",
          "提升服务质量"
        ],
        "constraints": [
          "金融监管合规",
          "数据安全要求",
          "实时性要求"
        ]
      },
      "expected_output": {
        "user_stories": {
          "count": 6,
          "format": "As a [user], I want [goal] so that [benefit]",
          "examples": [
            "作为个人投资者，我希望能够查看实时行情，以便做出投资决策",
            "作为理财顾问，我希望能够为客户制定投资组合，以便提供专业服务",
            "作为机构客户，我希望能够批量执行交易，以便提高操作效率"
          ]
        },
        "gwt_criteria": {
          "given": "用户已完成身份认证和风险评估",
