        "out_of_scope": [
          "设备硬件制造",
          "专业安装服务",
          "保险理赔服务"
        ]
      },
      "quality_metrics": {
        "clarity": 0.85,
        "completeness": 0.9,
        "testability": 0.85,
        "feasibility": 0.75
      }
    },
