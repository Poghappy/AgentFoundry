  ],
  "evaluation_criteria": {
    "clarity": {
      "description": "需求表达清晰度",
      "weight": 0.25,
      "metrics": [
        "用户故事表达清晰",
        "验收标准明确",
        "术语使用一致"
      ]
    },
    "completeness": {
      "description": "需求完整性",
      "weight": 0.3,
      "metrics": [
        "功能需求覆盖完整",
        "非功能需求明确",
        "边界条件考虑充分"
      ]
    },
    "testability": {
      "description": "可测试性",
      "weight": 0.25,
      "metrics": [
        "验收标准可验证",
        "指标可量化",
        "测试场景明确"
      ]
    },
    "feasibility": {
      "description": "可实现性",
      "weight": 0.2,
      "metrics": [
        "技术方案可行",
        "资源需求合理",
        "时间安排现实"
      ]
    }
  },
  "prd_structure_requirements": {
    "max_pages": 1,
    "required_sections": [
      "产品概述",
      "用户故事",
      "功能需求",
      "非功能需求",
      "验收标准",
      "范围外内容"
    ],
    "user_story_format": "Given-When-Then结构",
    "metrics_requirement": "每个功能都要有对应的埋点和指标"
  },
  "usage_instructions": {
    "purpose": "评测AI生成PRD的质量",
    "scoring": "按四个维度加权评分",
    "threshold": "总分≥0.85视为优秀，≥0.75视为合格，<0.7需要重写",
    "frequency": "每次PRD生成功能更新后运行"
  }
}