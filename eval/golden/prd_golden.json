{
  "name": "PRD评测黄金集",
  "description": "用于评测产品需求文档(PRD)质量的标准测试集",
  "version": "1.0.0",
  "created_date": "2025-01-20",
  "test_cases": [
    {
      "id": "PRD001",
      "input": {
        "product_type": "在线教育平台",
        "target_users": ["学生", "教师", "家长"],
        "business_goals": [
          "提高学习效率",
          "增加用户粘性",
          "扩大市场份额"
        ],
        "constraints": [
          "3个月MVP上线",
          "预算100万",
          "团队10人"
        ]
      },
      "expected_output": {
        "user_stories": {
          "count": 5,
          "format": "As a [user], I want [goal] so that [benefit]",
          "examples": [
            "作为学生，我希望能够在线观看课程视频，以便随时随地学习",
            "作为教师，我希望能够上传课程资料，以便学生下载学习",
            "作为家长，我希望能够查看孩子的学习进度，以便了解学习情况"
          ]
        },
        "gwt_criteria": {
          "given": "明确的前置条件",
          "when": "具体的用户操作",
          "then": "可验证的结果"
        },
        "functional_requirements": [
          "用户注册登录",
          "课程视频播放",
          "作业提交系统",
          "学习进度跟踪",
          "在线讨论区"
        ],
        "nfr": {
          "performance": "页面加载时间<3秒，视频播放延迟<2秒",
          "accessibility": "支持WCAG 2.1 AA标准，键盘导航",
          "observability": "用户行为埋点，性能监控，错误追踪"
        },
        "failure_scenarios": [
          "网络断开时显示离线提示",
          "视频加载失败时提供重试选项",
          "支付失败时保留购物车状态"
        ],
        "metrics_tracking": [
          "日活跃用户数(DAU)",
          "课程完成率",
          "用户留存率",
          "平均学习时长"
        ],
        "out_of_scope": [
          "移动端APP开发",
          "线下培训服务",
          "第三方支付集成"
        ]
      },
      "quality_metrics": {
        "clarity": 0.9,
        "completeness": 0.85,
        "testability": 0.9,
        "feasibility": 0.8
      }
    },
    {
      "id": "PRD002",
      "input": {
        "product_type": "智能家居控制系统",
        "target_users": ["家庭用户", "租户", "物业管理"],
        "business_goals": [
          "提升居住体验",
          "节能环保",
          "安全防护"
        ],
        "constraints": [
          "硬件成本限制",
          "网络稳定性",
          "隐私保护"
        ]
      },
      "expected_output": {
        "user_stories": {
          "count": 6,
          "format": "As a [user], I want [goal] so that [benefit]",
          "examples": [
            "作为家庭用户，我希望能够远程控制家电，以便回家前预先调节环境",
            "作为租户，我希望能够设置临时访客权限，以便朋友能够进入",
            "作为物业管理员，我希望能够监控公共区域设备状态，以便及时维护"
          ]
        },
        "gwt_criteria": {
          "given": "设备已连接且用户已认证",
          "when": "用户发送控制指令",
          "then": "设备响应并反馈状态"
        },
        "functional_requirements": [
          "设备自动发现和配对",
          "远程控制和监控",
          "场景模式设置",
          "定时任务管理",
          "安全报警系统"
        ],
        "nfr": {
          "performance": "控制响应时间<1秒，设备状态同步<5秒",
          "accessibility": "语音控制，大字体显示，色盲友好",
          "observability": "设备状态监控，能耗统计，故障预警"
        },
        "failure_scenarios": [
          "网络断开时本地控制仍可用",
          "设备离线时显示最后已知状态",
          "控制失败时提供手动操作指引"
        ],
        "metrics_tracking": [
          "设备在线率",
          "控制成功率",
          "能耗节省比例",
          "用户满意度"
