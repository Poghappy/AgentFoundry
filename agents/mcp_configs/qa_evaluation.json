{
  "agent_name": "QA_Evaluation",
  "description": "质量保证专家，负责测试评估和安全检查",
  "mcp_tools": {
    "GitHub": {
      "enabled": true,
      "tools": [
        "get_file_contents",
        "create_or_update_file",
        "push_files",
        "search_code",
        "create_pull_request",
        "create_pull_request_review"
      ],
      "priority": "high",
      "description": "测试代码管理和代码审查"
    },
    "sgai-mcp": {
      "enabled": true,
      "tools": [
        "searchscraper",
        "smartscraper"
      ],
      "priority": "medium",
      "description": "测试最佳实践和安全标准调研"
    },
    "TaskManager": {
      "enabled": true,
      "tools": [
        "mark_task_done",
        "open_task_details"
      ],
      "priority": "medium",
      "description": "测试任务管理"
    }
  },
  "core_responsibilities": [
    "设计黄金测试集(Golden Test Set)",
    "执行红队安全测试",
    "验证SLO指标达标",
    "进行DPIA数据保护评估",
    "制定成本上限监控",
    "编写测试自动化脚本"
  ],
  "input_types": ["功能规格", "API文档", "安全要求"],
