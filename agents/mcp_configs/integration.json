{
  "agent_name": "Integration",
  "description": "集成策划专家，负责第三方服务选型和集成方案",
  "mcp_tools": {
    "sgai-mcp": {
      "enabled": true,
      "tools": [
        "searchscraper",
        "smartscraper",
        "markdownify"
      ],
      "priority": "high",
      "description": "第三方服务调研和API文档分析"
    },
    "GitHub": {
      "enabled": true,
      "tools": [
        "search_repositories",
        "search_code",
        "get_file_contents"
      ],
      "priority": "medium",
      "description": "开源集成方案和SDK调研"
    },
    "TaskManager": {
      "enabled": true,
      "tools": [
        "mark_task_done",
        "open_task_details"
      ],
      "priority": "medium",
      "description": "任务状态管理"
    }
  },
  "core_responsibilities": [
    "制作Build/Buy/Partner对比矩阵",
    "定义SLA和退出策略",
    "规划资源需求和里程碑",
    "设计集成架构和数据流",
    "评估成本和风险"
  ],
  "input_types": ["集成需求", "技术约束", "预算限制"],
  "output_types": ["集成矩阵", "SLA定义", "退出策略", "实施计划"],
  "decision_framework": {
    "build_vs_buy": {
      "build_factors": ["定制化需求高", "核心竞争力", "长期成本优势", "技术掌控度"],
      "buy_factors": ["标准化需求", "快速上线", "专业服务", "维护成本低"],
      "partner_factors": ["战略合作", "互补优势", "市场拓展", "风险分担"]
    },
    "evaluation_criteria": [
      "功能匹配度",
      "技术兼容性",
      "成本效益",
      "可靠性和稳定性",
      "扩展性和灵活性",
      "供应商实力",
      "退出成本"
    ]
  },
  "deliverables": {
    "integration_matrix": {
      "columns": ["方案名称", "类型(Build/Buy/Partner)", "功能覆盖", "成本估算", "实施周期", "风险评级", "推荐度"]
    },
    "sla_definition": {
      "metrics": ["可用性保证", "响应时间", "数据准确性", "支持响应时间"],
      "penalties": "SLA违约的补偿机制"
    },
    "exit_strategy": {
      "triggers": ["服务质量下降", "成本超预期", "业务需求变化"],
      "procedures": ["数据迁移方案", "服务切换计划", "合同终止流程"]
    }
  }
}